# Template only. Set real values on the target staging server; never commit secrets.
NODE_ENV=production
DEPLOYMENT_ENV=staging
NEXT_TELEMETRY_DISABLED=1

# MySQL. URL-encode reserved characters in username/password.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Generate independently; minimum 32 random bytes each.
SESSION_SECRET=CHANGE_ME
OTP_SECRET=CHANGE_ME

# Production-mode staging requires real SMTP for OTP email delivery.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=Warkost Bahagia <no-reply@example.com>

# Absolute writable paths outside the generated Node.js release directory.
UPLOAD_DIRECTORY=/srv/warkost/storage/uploads
BACKUP_DIRECTORY=/srv/warkost/storage/backups/database

# Staging-only UAT accounts. Minimum 14 characters, unique, and secret.
STAGING_UAT_PASSWORD=CHANGE_ME

# Optional one-time password rotation. Remove after one successful restart.
# STAGING_RESET_DEMO_PASSWORD=true

# Optional Web Push V1. Leave all three blank to keep push unavailable.
# Public key may be exposed through authenticated /api/push; private key is server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Geoapify brake V1. Live transport is not wired in this release.
GEOLOCATION_EXTERNAL_ENABLED=false
GEOLOCATION_TRUST_PROXY=false
# GEOAPIFY_API_KEY=
