# Development SQLite (default). Pakai absolute path untuk server Node.
DATABASE_PATH=./data/warkost.db
# Untuk MySQL, set DATABASE_URL; jika aktif, DATABASE_PATH diabaikan.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/warkost_bahagia
SESSION_SECRET=ganti-dengan-random-minimal-32-karakter
# Folder gambar produk. Gunakan path absolut yang persisten di production.
UPLOAD_DIRECTORY=./data/uploads
# Folder backup SQLite. Production wajib memakai path absolut yang berbeda dari upload.
BACKUP_DIRECTORY=./backups
# Hanya untuk demo/test lokal. Jangan gunakan mode simulation di production.
# PAYMENT_PROVIDER_MODE=simulation
# PAYMENT_WEBHOOK_SECRET=ganti-dengan-random-minimal-32-karakter
