# Development SQLite (default). Pakai absolute path untuk server Node.
DATABASE_PATH=./data/warkost.db
# Untuk MySQL, set DATABASE_URL; jika aktif, DATABASE_PATH diabaikan.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/warkost_bahagia
SESSION_SECRET=ganti-dengan-random-minimal-32-karakter
# Rahasia HMAC OTP, wajib unik dan minimal 32 byte di production.
OTP_SECRET=ganti-dengan-random-otp-minimal-32-karakter
# Production wajib smtp. Development/test default menulis preview ke .uat/.
EMAIL_TRANSPORT=development
# OTP_OUTBOX_PATH=.uat/otp-outbox.json
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user-smtp
# SMTP_PASS=isi-di-environment-production
# SMTP_FROM=Warkost Bahagia <no-reply@example.com>
# Folder gambar produk. Gunakan path absolut yang persisten di production.
UPLOAD_DIRECTORY=./data/uploads
# Folder backup SQLite. Production wajib memakai path absolut yang berbeda dari upload.
BACKUP_DIRECTORY=./backups
# Hanya untuk demo/test lokal. Jangan gunakan mode simulation di production.
# PAYMENT_PROVIDER_MODE=simulation
# PAYMENT_WEBHOOK_SECRET=ganti-dengan-random-minimal-32-karakter

# Midtrans sandbox, hanya pada SQLite UAT terisolasi. Switch Owner default OFF.
# DEPLOYMENT_ENV=isolated-uat
# PAYMENT_PROVIDER_MODE=midtrans-sandbox
# MIDTRANS_SANDBOX_SERVER_KEY=
# MIDTRANS_SANDBOX_MERCHANT_ID=

# Optional Web Push V1. Leave all three blank to keep push unavailable.
# Public key may be exposed through authenticated /api/push; private key is server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Geoapify brake V1. Live transport is not wired in this release.
GEOLOCATION_EXTERNAL_ENABLED=false
GEOLOCATION_TRUST_PROXY=false
# GEOAPIFY_API_KEY=
