# Template only. Set real values in Hostinger hPanel; never commit secrets.
NODE_ENV=production
DEPLOYMENT_ENV=staging
NEXT_TELEMETRY_DISABLED=1

# Hostinger MySQL. URL-encode reserved characters in username/password.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Generate independently; minimum 32 random bytes.
SESSION_SECRET=CHANGE_ME

# Absolute writable paths outside the generated Node.js release directory.
UPLOAD_DIRECTORY=/home/HOSTINGER_USER/domains/STAGING_DOMAIN/storage/uploads
BACKUP_DIRECTORY=/home/HOSTINGER_USER/domains/STAGING_DOMAIN/storage/backups/database

# Staging-only UAT accounts. Minimum 14 characters, unique, and secret.
STAGING_UAT_PASSWORD=CHANGE_ME

# Optional one-time password rotation. Remove after one successful restart.
# STAGING_RESET_DEMO_PASSWORD=true
